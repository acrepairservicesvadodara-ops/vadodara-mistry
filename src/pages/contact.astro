---
import Layout from "../layouts/Layout.astro";
import BookingForm from "../components/BookingForm";
import { Phone, Mail, MapPin, Clock, MessageCircle } from "lucide-react";
---

<Layout
  title="Contact Vadodara Mistry | Home Services | +91 93139 82980"
  description="Contact Vadodara Mistry for home services in Vadodara. Call +91 93139 82980 or WhatsApp us. Same-day service available."
  canonical="https://vadodaramistry.com/contact"
>
  <!-- Hero -->
  <section class="relative text-white py-8 md:py-20 overflow-hidden">
    <div class="absolute inset-0">
      <img
        src="https://images.unsplash.com/photo-1423666639041-f56000c27a9a?w=1920&q=80"
        alt="Contact Vadodara Mistry"
        class="absolute inset-0 w-full h-full object-cover"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-orange-600/95 via-orange-600/90 to-orange-500/80" />
    </div>
    <div class="container mx-auto px-4 relative">
      <div class="md:hidden mb-6">
        <BookingForm client:load title="Book Service Now" compact />
      </div>
      <div class="text-center">
        <h1 class="text-3xl md:text-5xl font-bold mb-4 md:mb-6">
          Contact <span class="text-yellow-300">Vadodara Mistry</span>
        </h1>
        <p class="text-lg md:text-xl text-orange-100 max-w-2xl mx-auto">
          Get in touch for painting, plumbing, carpentry, civil work & more.
          We're here to help 7 days a week.
        </p>
      </div>
    </div>
  </section>

  <!-- Contact Info Cards -->
  <section class="py-16 bg-white">
    <div class="container mx-auto px-4">
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6 max-w-5xl mx-auto">
        <a href="tel:+919313982980" class="bg-blue-50 hover:bg-blue-100 p-6 rounded-xl text-center transition group">
          <div class="w-14 h-14 bg-blue-600 rounded-full flex items-center justify-center mx-auto mb-4 group-hover:scale-110 transition">
            <Phone className="w-7 h-7 text-white" />
          </div>
          <h3 class="font-semibold text-gray-900 mb-1">Call Us</h3>
          <p class="text-blue-600 font-medium">+91 93139 82980</p>
        </a>

        <a href="https://wa.me/919313982980" target="_blank" rel="noopener noreferrer" class="bg-green-50 hover:bg-green-100 p-6 rounded-xl text-center transition group">
          <div class="w-14 h-14 bg-green-500 rounded-full flex items-center justify-center mx-auto mb-4 group-hover:scale-110 transition">
            <MessageCircle className="w-7 h-7 text-white" />
          </div>
          <h3 class="font-semibold text-gray-900 mb-1">WhatsApp</h3>
          <p class="text-green-600 font-medium">Chat with us</p>
        </a>

        <a href="mailto:info@vadodaramistry.com" class="bg-orange-50 hover:bg-orange-100 p-6 rounded-xl text-center transition group">
          <div class="w-14 h-14 bg-orange-500 rounded-full flex items-center justify-center mx-auto mb-4 group-hover:scale-110 transition">
            <Mail className="w-7 h-7 text-white" />
          </div>
          <h3 class="font-semibold text-gray-900 mb-1">Email Us</h3>
          <p class="text-orange-600 font-medium text-sm">info@vadodaramistry.com</p>
        </a>

        <div class="bg-purple-50 p-6 rounded-xl text-center">
          <div class="w-14 h-14 bg-purple-500 rounded-full flex items-center justify-center mx-auto mb-4">
            <Clock className="w-7 h-7 text-white" />
          </div>
          <h3 class="font-semibold text-gray-900 mb-1">Working Hours</h3>
          <p class="text-purple-700 text-sm">Mon-Sat: 9AM-8PM</p>
          <p class="text-purple-600 text-sm">Sun: 10AM-6PM</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact Form & Map -->
  <section class="py-16 bg-gray-50">
    <div class="container mx-auto px-4">
      <div class="grid md:grid-cols-2 gap-12 max-w-6xl mx-auto">
        <div>
          <BookingForm client:load title="Send Us a Message" />
        </div>

        <div>
          <h2 class="text-2xl font-bold mb-6">Our Office</h2>

          <div class="bg-white p-6 rounded-xl shadow-sm mb-6">
            <div class="flex items-start gap-4 mb-4">
              <MapPin className="w-6 h-6 text-blue-600 flex-shrink-0 mt-1" />
              <div>
                <h3 class="font-semibold text-gray-900">Vadodara Mistry</h3>
                <p class="text-gray-600">Sayajigunj, Vadodara</p>
                <p class="text-gray-600">Gujarat 390005, India</p>
              </div>
            </div>

            <div class="flex items-center gap-4 mb-4">
              <Phone className="w-6 h-6 text-blue-600" />
              <div>
                <p class="text-gray-600">+91 93139 82980</p>
              </div>
            </div>

            <div class="flex items-center gap-4">
              <Mail className="w-6 h-6 text-blue-600" />
              <div>
                <p class="text-gray-600">info@vadodaramistry.com</p>
              </div>
            </div>
          </div>

          <div class="bg-gray-200 rounded-xl overflow-hidden h-80">
            <iframe
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3691.169558279991!2d73.1812!3d22.3072!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zMjLCsDE4JzI2LjAiTiA3M8KwMTAnNTIuMyJF!5e0!3m2!1sen!2sin!4v1234567890"
              width="100%"
              height="100%"
              style="border:0"
              allowfullscreen
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              title="Vadodara Mistry Location"
            ></iframe>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Service Areas -->
  <section class="py-16 bg-white">
    <div class="container mx-auto px-4 text-center">
      <h2 class="text-2xl font-bold mb-8">We Serve All Areas of Vadodara</h2>
      <p class="text-gray-600 max-w-2xl mx-auto mb-8">
        Alkapuri, Gotri, Manjalpur, Akota, Fatehgunj, Karelibaug, Sayajigunj, Waghodia,
        Harni, Vasna, Sama, Tandalja, Subhanpura, Gorwa, Nizampura, and 40+ more areas.
      </p>
      <p class="text-gray-600">
        Also serving: Ahmedabad, Surat, Bharuch, Anand, Gandhinagar, and nearby cities.
      </p>
    </div>
  </section>

  <!-- Quick CTA -->
  <section class="py-12 bg-blue-600 text-white">
    <div class="container mx-auto px-4 text-center">
      <h2 class="text-2xl font-bold mb-4">Need Urgent Home Service?</h2>
      <p class="text-blue-100 mb-6">Call now for same-day service in Vadodara!</p>
      <a href="tel:+919313982980" class="inline-flex items-center gap-2 bg-yellow-500 hover:bg-yellow-400 text-gray-900 px-8 py-4 rounded-full font-bold text-lg transition">
        <Phone size={22} />
        +91 93139 82980
      </a>
    </div>
  </section>
</Layout>
