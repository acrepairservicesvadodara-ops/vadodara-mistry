              <div class="inline-flex items-center gap-2 bg-white/10 backdrop-blur px-4 py-2 rounded-full text-sm mb-4">
                <span>⭐ 4.8/5 Rating • 10,000+ Happy Customers</span>
              </div>
              <h1 class="text-3xl md:text-5xl font-bold mb-4 md:mb-6">{keyword.title} in Vadodara</h1>
