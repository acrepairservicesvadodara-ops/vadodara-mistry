---
import Layout from "../layouts/Layout.astro";
import BookingForm from "../components/BookingForm";
import Testimonials from "../components/Testimonials";
import ImageSlider from "../components/ImageSlider";
import {
  Phone,
  MapPin,
  Clock,
  CheckCircle,
  Shield,
  Award,
  Users,
  ArrowRight,
} from "lucide-react";
import {
  mainServices,
  areas,
  categoryConfig,
  categoryImages,
  serviceAreaSlug,
  generateFAQs,
  generateExtendedContent,
} from "../lib/service-area-data";
import {
  generateFAQSchema,
  generateLocalBusinessSchema,
  generateServiceSchema,
  generateBreadcrumbSchema,
} from "../lib/business-config";
import { allKeywords, vadodaraAreas, categoryConfig as dataCategoryConfig, categoryImages as dataCategoryImages } from "../lib/data";
import {
  generateKeywordContent,
  categoryContent,
  generateUniqueFAQs,
} from "../lib/seo-content";
import { serviceCategories as areaHubServiceCategories, generateAreaFAQs, generateAreaAbout } from "../lib/area-hub-data";
import { categoryOverviewPages } from "../lib/category-overview-data";
import HomeServiceTemplate from "../components/HomeServiceTemplate";
import BusinessInfo from "../components/BusinessInfo";
import CallButton from "../components/CallButton";

export async function getStaticPaths() {
  const paths: any[] = [];

  // Family B: service x area combination pages (615 total)
  for (const service of mainServices) {
    // city page: service-in-vadodara
    paths.push({
      params: { slug: serviceAreaSlug(service, null, true) },
      props: { kind: "service-area", service, areaName: null, isCity: true },
    });
    // area pages: service-area-vadodara
    for (const area of areas) {
      paths.push({
        params: { slug: serviceAreaSlug(service, area.name, false) },
        props: { kind: "service-area", service, areaName: area.name, isCity: false },
      });
    }
  }

  // Family A: single keyword pages (350 total)
  for (const keyword of allKeywords) {
    paths.push({
      params: { slug: keyword.slug },
      props: { kind: "keyword", keyword },
    });
  }

  // Family C: area hub pages (40 total)
  for (const area of vadodaraAreas) {
    paths.push({
      params: { slug: `${area.slug}-vadodara` },
      props: { kind: "area-hub", areaHubName: area.name },
    });
  }

  // Family D: category overview pages (3 total)
  for (const page of categoryOverviewPages) {
    paths.push({
      params: { slug: page.slug },
      props: { kind: "category-overview", overviewPage: page },
    });
  }

  return paths;
}

const props = Astro.props as
  | { kind: "service-area"; service: (typeof mainServices)[number]; areaName: string | null; isCity: boolean }
  | { kind: "keyword"; keyword: (typeof allKeywords)[number] }
  | { kind: "area-hub"; areaHubName: string }
  | { kind: "category-overview"; overviewPage: (typeof categoryOverviewPages)[number] };

const { kind } = props;

let metaTitle = "";
let metaDesc = "";
let canonical = "";
let layoutKeywords: string[] = [];
let jsonLdArr: object[] = [];

// ---- service-area branch state ----
let service!: (typeof mainServices)[number];
let areaName: string | null = null;
let isCity = false;
let location = "";
let locationShort = "";
let slug = "";
let config!: (typeof categoryConfig)[keyof typeof categoryConfig];
let faqs: { question: string; answer: string }[] = [];
let content!: ReturnType<typeof generateExtendedContent>;
let title = "";
let otherAreas: typeof areas = [];

// ---- keyword branch state ----
let keyword!: (typeof allKeywords)[number];
let category: keyof typeof dataCategoryConfig;
let kwConfig!: (typeof dataCategoryConfig)[keyof typeof dataCategoryConfig];
let kwImages: { src: string; alt: string }[] = [];
let kwContent!: ReturnType<typeof generateKeywordContent>;
let uniqueFAQs: { question: string; answer: string }[] = [];
let relatedServices: typeof allKeywords = [];
let kwCatContent!: (typeof categoryContent)[keyof typeof categoryContent];

// ---- area-hub branch state ----
let areaHubName = "";
let nearbyAreas: typeof vadodaraAreas = [];
let areaFAQs: { question: string; answer: string }[] = [];
let areaAbout: string[] = [];
let areaGalleryImages: { src: string; alt: string }[] = [];

// ---- category-overview branch state ----
let overviewPage!: (typeof categoryOverviewPages)[number];

if (kind === "service-area") {
  ({ service, areaName, isCity } = props);
  location = isCity ? "Vadodara" : `${areaName}, Vadodara`;
  locationShort = isCity ? "Vadodara" : (areaName as string);
  slug = serviceAreaSlug(service, areaName, isCity);
  config = categoryConfig[service.category];
  faqs = generateFAQs(service, areaName, isCity);
  content = generateExtendedContent(service, areaName, isCity);
  title = isCity ? `${service.name} in Vadodara` : `${service.name} in ${areaName}, Vadodara`;
  metaTitle = `${service.name} in ${locationShort} | Best ${service.name} Services - Vadodara Mistry`;
  metaDesc = `Expert ${service.name} in ${location}. Professional services, premium materials, 10+ years experience. Free quote: +91 93139 82980. Trusted by 5000+ customers.`;
  canonical = `https://vadodaramistry.com/${slug}`;
  layoutKeywords = [...service.keywords, locationShort, "Vadodara"];

  const faqSchema = generateFAQSchema(faqs);
  const localBusinessSchema = generateLocalBusinessSchema();
  const serviceSchema = generateServiceSchema({ title: service.name, description: metaDesc, slug });
  const breadcrumbSchema = generateBreadcrumbSchema([
    { name: "Home", url: "https://vadodaramistry.com" },
    { name: service.name, url: `https://vadodaramistry.com/${service.slug}-in-vadodara` },
    ...(!isCity ? [{ name: areaName as string, url: `https://vadodaramistry.com/${slug}` }] : []),
  ]);
  jsonLdArr = [faqSchema, localBusinessSchema, serviceSchema, breadcrumbSchema];
  otherAreas = areas.filter((a) => a.name !== areaName).slice(0, 15);
} else if (kind === "keyword") {
  ({ keyword } = props);
  category = keyword.category;
  kwConfig = dataCategoryConfig[category];
  kwImages = dataCategoryImages[category];
  kwContent = generateKeywordContent(keyword, category);
  kwCatContent = categoryContent[category];
  uniqueFAQs = generateUniqueFAQs(keyword, category);
  relatedServices = allKeywords.filter((k) => k.category === category && k.slug !== keyword.slug).slice(0, 8);

  slug = keyword.slug;
  metaTitle = `${keyword.title} in Vadodara | Professional ${keyword.title} Services - Vadodara Mistry`;
  metaDesc = `Looking for ${keyword.title.toLowerCase()} in Vadodara? Vadodara Mistry offers professional ${keyword.description.toLowerCase()}. ✓ 12+ Years Experience ✓ 10,000+ Happy Customers ✓ Best Prices ✓ Quality Work. Call +91 93139 82980`;
  canonical = `https://vadodaramistry.com/${slug}`;
  layoutKeywords = [keyword.title, `${keyword.title} Vadodara`, `${keyword.title} services`, `best ${keyword.title.toLowerCase()}`, `${keyword.title.toLowerCase()} near me`, "Vadodara Mistry"];

  const faqSchema = generateFAQSchema(uniqueFAQs);
  const localBusinessSchema = generateLocalBusinessSchema(keyword.title);
  const serviceSchema = generateServiceSchema(keyword);
  const breadcrumbSchema = generateBreadcrumbSchema([
    { name: "Home", url: "https://vadodaramistry.com" },
    { name: dataCategoryConfig[category].title, url: `https://vadodaramistry.com/${category}-vadodara` },
    { name: keyword.title, url: `https://vadodaramistry.com/${keyword.slug}` },
  ]);
  jsonLdArr = [faqSchema, localBusinessSchema, serviceSchema, breadcrumbSchema];
} else if (kind === "area-hub") {
  ({ areaHubName } = props);
  slug = `${areaHubName.toLowerCase().replace(/\s+/g, "-")}-vadodara`;
  nearbyAreas = vadodaraAreas.filter((a) => a.name !== areaHubName).slice(0, 8);
  areaFAQs = generateAreaFAQs(areaHubName);
  areaAbout = generateAreaAbout(areaHubName);
  areaGalleryImages = [
    ...dataCategoryImages.painting.slice(0, 2),
    ...dataCategoryImages.civil.slice(0, 2),
    ...dataCategoryImages.carpenter.slice(0, 2),
  ];

  metaTitle = `Home Services in ${areaHubName}, Vadodara | Painter, Plumber, Carpenter - Vadodara Mistry`;
  metaDesc = `Best home services in ${areaHubName}, Vadodara. Professional painters, plumbers, carpenters, civil contractors & fabrication work. 12+ years experience, 10,000+ customers. Call +91 93139 82980`;
  canonical = `https://vadodaramistry.com/${slug}`;
  layoutKeywords = [`home services ${areaHubName.toLowerCase()} vadodara`, `painter ${areaHubName.toLowerCase()}`, `plumber ${areaHubName.toLowerCase()}`, `carpenter ${areaHubName.toLowerCase()}`, `civil contractor ${areaHubName.toLowerCase()}`];

  const faqSchema = generateFAQSchema(areaFAQs);
  const localBusinessSchema = generateLocalBusinessSchema(`Home Services in ${areaHubName}`);
  const breadcrumbSchema = generateBreadcrumbSchema([
    { name: "Home", url: "https://vadodaramistry.com" },
    { name: "Areas", url: "https://vadodaramistry.com/areas" },
    { name: areaHubName, url: `https://vadodaramistry.com/${slug}` },
  ]);
  jsonLdArr = [faqSchema, localBusinessSchema, breadcrumbSchema];
} else {
  ({ overviewPage } = props);
  slug = overviewPage.slug;
  metaTitle = overviewPage.metaTitle;
  metaDesc = overviewPage.metaDescription;
  canonical = `https://vadodaramistry.com/${slug}`;
}
---

<Layout
  title={metaTitle}
  description={metaDesc}
  canonical={canonical}
  keywords={layoutKeywords}
  jsonLd={jsonLdArr}
>
  <main class="min-h-screen">
    {kind === "keyword" && (
