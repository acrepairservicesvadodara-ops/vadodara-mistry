            </div>
          </div>
        </div>
      </section>

      <!-- Image Gallery -->
      <section class="py-12 bg-white">
        <div class="container mx-auto px-4">
          <h2 class="text-3xl font-bold text-center mb-8">Our {kwConfig.title} Work Gallery</h2>
          <div class="max-w-4xl mx-auto">
            <ImageSlider client:visible images={kwImages} autoPlay={true} interval={4000} />
          </div>
        </div>
      </section>

      <!-- Features -->
      <section class="py-16 bg-white">
        <div class="container mx-auto px-4">
          <h2 class="text-3xl font-bold text-center mb-12">Why Choose Us for {keyword.title}?</h2>
          <div class="grid md:grid-cols-4 gap-8">
            {[
              { icon: "✓", title: "12+ Years Experience", desc: "Trusted expertise since 2012" },
              { icon: "⚡", title: "Quick Response", desc: "Same day service available" },
              { icon: "💰", title: "Best Prices", desc: "Transparent pricing, no hidden costs" },
              { icon: "🛡️", title: "Quality Assured", desc: "Warranty on all work" },
            ].map((feature) => (
              <div class="text-center p-6 rounded-xl bg-gray-50">
                <div class="text-4xl mb-4">{feature.icon}</div>
                <h3 class="font-semibold text-lg mb-2">{feature.title}</h3>
                <p class="text-gray-600">{feature.desc}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- About -->
      <section class="py-16 bg-gray-50">
        <div class="container mx-auto px-4">
          <div class="max-w-4xl mx-auto prose prose-lg">
            <div class="bg-white rounded-2xl p-8 shadow-sm mb-8">
              <h2 class="text-3xl font-bold text-gray-900 mb-6">About {keyword.title} Services in Vadodara</h2>
              <div class="text-gray-700 leading-relaxed space-y-4">
                <p>{kwContent.introduction}</p>
                <p>{kwContent.detailedDescription}</p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Why Choose Us list -->
      <section class="py-16 bg-white">
        <div class="container mx-auto px-4">
          <h2 class="text-3xl font-bold text-center mb-12">Why Choose Vadodara Mistry for {keyword.title}?</h2>
          <div class="grid md:grid-cols-2 gap-4 max-w-4xl mx-auto">
            {kwCatContent.whyChooseUs.map((reason) => (
              <div class="flex items-start gap-3 p-4 bg-gray-50 rounded-lg">
                <span class="text-green-600 font-bold text-xl">✓</span>
                <p class="text-gray-700">{reason}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- Process -->
      <section class="py-16 bg-gray-50">
        <div class="container mx-auto px-4">
          <h2 class="text-3xl font-bold text-center mb-4">Our {keyword.title} Process</h2>
          <p class="text-center text-gray-600 mb-12 max-w-2xl mx-auto">
            We follow a systematic approach to ensure quality results for every {keyword.title.toLowerCase()} project
          </p>
          <div class="max-w-4xl mx-auto space-y-6">
            {kwCatContent.serviceProcess.map((step, idx) => (
              <div class="bg-white rounded-xl p-6 shadow-sm flex gap-6">
                <div class="w-12 h-12 rounded-full bg-orange-100 flex items-center justify-center flex-shrink-0">
                  <span class="text-xl font-bold text-orange-600">{idx + 1}</span>
                </div>
                <div>
                  <h3 class="font-bold text-lg text-gray-900 mb-2">{step.title}</h3>
                  <p class="text-gray-600">{step.description}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- Testimonials -->
      <Testimonials filterService={category} limit={6} />

      <!-- Service Areas -->
      <section class="py-16 bg-white">
        <div class="container mx-auto px-4">
          <h2 class="text-3xl font-bold text-center mb-4">{keyword.title} Service Areas in Vadodara</h2>
          <p class="text-center text-gray-600 mb-12">We provide {keyword.title.toLowerCase()} services across all Vadodara areas</p>
          <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-5 gap-3">
            {vadodaraAreas.map((area) => (
              <a href={`/${area.slug}-vadodara`} class="p-3 bg-gray-50 hover:bg-orange-50 rounded-lg text-center text-sm hover:text-orange-600 transition">
                {area.name}
              </a>
            ))}
          </div>
        </div>
      </section>

      <!-- FAQ -->
      <section class="py-16 bg-gray-50">
        <div class="container mx-auto px-4">
          <h2 class="text-3xl font-bold text-center mb-4">Frequently Asked Questions About {keyword.title}</h2>
          <p class="text-center text-gray-600 mb-12 max-w-2xl mx-auto">
            Find answers to common questions about our {keyword.title.toLowerCase()} services in Vadodara
          </p>
          <div class="max-w-3xl mx-auto space-y-4">
            {uniqueFAQs.map((faq) => (
              <details class="bg-white rounded-xl p-6 shadow-sm group">
                <summary class="font-semibold cursor-pointer list-none flex justify-between items-center">
                  {faq.question}
                  <span class="text-orange-500 group-open:rotate-180 transition">▼</span>
                </summary>
                <p class="mt-4 text-gray-600">{faq.answer}</p>
              </details>
            ))}
          </div>
        </div>
      </section>

      <!-- Related Services -->
      <section class="py-16 bg-white">
        <div class="container mx-auto px-4">
          <h2 class="text-3xl font-bold text-center mb-12">Related Services</h2>
          <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
            {relatedServices.map((rs) => (
              <a href={`/${rs.slug}`} class="p-4 border border-gray-200 rounded-xl hover:border-orange-500 hover:shadow-md transition text-center">
                <h3 class="font-medium">{rs.title}</h3>
              </a>
            ))}
          </div>
        </div>
      </section>

      <!-- CTA -->
      <section class={`${kwConfig.gradient} bg-gradient-to-br py-16`}>
        <div class="container mx-auto px-4 text-center text-white">
          <h2 class="text-3xl font-bold mb-4">Need {keyword.title} Service in Vadodara?</h2>
          <p class="text-xl mb-8 text-white/90">Call us now for instant service. Available 7 days a week.</p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a href="tel:+919313982980" class="bg-white text-gray-900 hover:bg-gray-100 px-8 py-4 rounded-xl font-semibold text-lg inline-flex items-center justify-center gap-2">
              <Phone className="w-5 h-5" />
              Call Now
            </a>
            <a href="https://wa.me/919313982980" class="bg-green-500 hover:bg-green-600 text-white px-8 py-4 rounded-xl font-semibold text-lg inline-flex items-center justify-center gap-2">
              WhatsApp Us
            </a>
          </div>
        </div>
      </section>
    </Fragment>
    )}

    {kind === "area-hub" && (
    <Fragment>
      <!-- Breadcrumb -->
      <nav class="bg-gray-100 py-3">
        <div class="container mx-auto px-4">
          <ol class="flex items-center gap-2 text-sm text-gray-600">
            <li><a href="/" class="hover:text-orange-600">Home</a></li>
            <li>/</li>
            <li><a href="/areas" class="hover:text-orange-600">Areas</a></li>
            <li>/</li>
            <li class="text-orange-600 font-medium">{areaHubName}</li>
          </ol>
        </div>
      </nav>

      <!-- Hero -->
      <section class="relative bg-gradient-to-br from-orange-500 via-orange-600 to-orange-700 text-white py-12 md:py-20">
        <div class="container mx-auto px-4">
          <div class="grid lg:grid-cols-2 gap-8 items-center">
            <div>
              <div class="inline-flex items-center gap-2 bg-white/10 backdrop-blur px-4 py-2 rounded-full text-sm mb-6">
                <span>📍 Serving {areaHubName}, Vadodara</span>
              </div>
              <h1 class="text-3xl md:text-5xl font-bold mb-6">Best Home Services in {areaHubName}, Vadodara</h1>
              <p class="text-xl text-white/90 mb-8">
                Professional painters, plumbers, carpenters, civil contractors & more in {areaHubName}.
                Trusted by families and businesses across Vadodara.
              </p>
              <div class="grid grid-cols-3 gap-4 mb-8">
                <div class="text-center">
                  <p class="text-3xl font-bold">12+</p>
                  <p class="text-sm text-white/80">Years Experience</p>
                </div>
                <div class="text-center">
                  <p class="text-3xl font-bold">10K+</p>
                  <p class="text-sm text-white/80">Happy Customers</p>
                </div>
                <div class="text-center">
                  <p class="text-3xl font-bold">4.8</p>
                  <p class="text-sm text-white/80">Google Rating</p>
                </div>
              </div>
              <div class="hidden md:flex flex-col sm:flex-row gap-4">
                <CallButton className="bg-white text-gray-900 hover:bg-gray-100 px-8 py-4 rounded-xl font-semibold text-lg" />
                <a href={`https://wa.me/919313982980?text=Hi, I need home services in ${areaHubName}, Vadodara`} class="bg-green-500 hover:bg-green-600 text-white px-8 py-4 rounded-xl font-semibold text-lg inline-flex items-center justify-center gap-2">
                  WhatsApp Us
                </a>
              </div>
            </div>
            <div class="bg-white rounded-2xl p-6 shadow-2xl">
              <BookingForm client:load title={`Get Free Quote in ${areaHubName}`} />
            </div>
          </div>
        </div>
      </section>

      <!-- Mobile CTA -->
      <div class="md:hidden sticky top-0 z-40 bg-white shadow-md p-3 flex gap-2">
        <CallButton className="flex-1 bg-orange-600 text-white py-3 rounded-lg font-semibold text-center" />
        <a href="https://wa.me/919313982980" class="flex-1 bg-green-600 text-white py-3 rounded-lg font-semibold text-center">
          WhatsApp
        </a>
      </div>

      <!-- Services Grid -->
      <section class="py-16 bg-white">
        <div class="container mx-auto px-4">
          <h2 class="text-3xl font-bold text-center mb-4">Our Services in {areaHubName}</h2>
          <p class="text-center text-gray-600 mb-12 max-w-2xl mx-auto">
            Comprehensive home services delivered by experienced professionals right in your neighborhood
          </p>
          <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
            {areaHubServiceCategories.map((cat) => (
              <div class="bg-gray-50 rounded-xl p-6 hover:shadow-lg transition">
                <h3 class="text-xl font-bold text-gray-900 mb-4">{cat.title}</h3>
                <ul class="space-y-2 mb-4">
                  {cat.services.map((svc) => (
                    <li class="flex items-center gap-2 text-gray-600">
                      <span class="text-green-500">✓</span> {svc}
                    </li>
                  ))}
                </ul>
                <a href={cat.href} class="text-orange-600 hover:text-orange-700 font-semibold">View All →</a>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- About -->
      <section class="py-16 bg-gray-50">
        <div class="container mx-auto px-4">
          <div class="max-w-4xl mx-auto">
            <h2 class="text-3xl font-bold text-gray-900 mb-8 text-center">Professional Home Services in {areaHubName}, Vadodara</h2>
            <div class="prose prose-lg max-w-none bg-white rounded-2xl p-8 shadow-sm">
              {areaAbout.map((p) => <p>{p}</p>)}
            </div>
          </div>
        </div>
      </section>

      <!-- Image Slider -->
