                <div class="flex items-center gap-2 bg-white/10 px-3 py-2 rounded-lg">
                  <span>✓</span>
                  <span class="text-sm">12+ Years Experience</span>
                </div>
                <div class="flex items-center gap-2 bg-white/10 px-3 py-2 rounded-lg">
                  <span>✓</span>
                  <span class="text-sm">Free Quotation</span>
                </div>
                <div class="flex items-center gap-2 bg-white/10 px-3 py-2 rounded-lg">
                  <span>✓</span>
                  <span class="text-sm">Warranty Included</span>
                </div>
              </div>
              <div class="flex flex-col sm:flex-row gap-4">
                <a href="tel:+919313982980" class="bg-white text-gray-900 hover:bg-gray-100 px-8 py-4 rounded-xl font-semibold text-lg inline-flex items-center justify-center gap-2">
                  <Phone className="w-5 h-5" />
                  Call: +91 93139 82980
                </a>
                <a href={`https://wa.me/919313982980?text=Hi, I need ${keyword.title} service in Vadodara`} class="bg-green-500 hover:bg-green-600 text-white px-8 py-4 rounded-xl font-semibold text-lg inline-flex items-center justify-center gap-2">
                  WhatsApp Us
                </a>
              </div>
            </div>
